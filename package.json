{
  "name": "dsh-live",
  "version": "0.1.0-preview.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "End-to-end encrypted mobile approval companion for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "agent",
    "approval",
    "mobile",
    "pwa",
    "e2ee",
    "websocket"
  ],
  "homepage": "https://github.com/zhoushuoshi-code/dsh-live#readme",
  "bugs": {
    "url": "https://github.com/zhoushuoshi-code/dsh-live/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhoushuoshi-code/dsh-live.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-live-relay": "./lib/relay/cli.js"
  },
  "files": [
    "lib",
    "mobile-dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-mobile.mjs",
    "relay": "node lib/relay/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-host-apiproxy": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
